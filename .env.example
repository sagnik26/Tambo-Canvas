# Environment Variables

NEXT_PUBLIC_TAMBO_API_KEY=

# Server-only: used by /api/generate-flow to call OpenAI for flow generation
OPENAI_API_KEY=

# Supabase settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: production URL for OAuth redirects (e.g. https://your-app.vercel.app). Set in Vercel env so Google sign-in redirects to your deployed site.
NEXT_PUBLIC_APP_URL=

